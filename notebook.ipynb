      "['waterfront', 'view', 'grade', 'lat', 'long', 'sqm_living', 'sqm_lot']\n"
     ]
    }
   ],
   "source": [
    "# Forward feature selection: we add the feature that improves the R2 the most, one by one\n",
    "rf_forward = RandomForestRegressor(n_estimators=50, max_depth=10, random_state=42, n_jobs=-1)\n",
    "forward = SequentialFeatureSelector(rf_forward, n_features_to_select=\"auto\", tol=0.001,\n",
    "                                    direction=\"forward\", scoring=\"r2\", cv=3)\n",
    "forward.fit(X_train, y_train)\n",
    "\n",
    "forward_selected = [f for f, keep in zip(features, forward.get_support()) if keep]\n",
    "print(forward_selected)"
   ]
  },
