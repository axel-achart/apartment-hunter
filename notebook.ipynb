   "source": [
    "# Boruta: compares each feature to shuffled copies of the features\n",
    "rf_boruta = RandomForestRegressor(n_jobs=-1, max_depth=7, random_state=42)\n",
    "boruta = BorutaPy(rf_boruta, n_estimators=\"auto\", max_iter=50, random_state=42)\n",
    "boruta.fit(X_train.values, y_train.values)\n",
    "\n",
    "boruta_selected = [f for f, keep in zip(features, boruta.support_) if keep]\n",
    "boruta_tentative = [f for f, maybe in zip(features, boruta.support_weak_) if maybe]\n",
    "print(\"Confirmed :\", boruta_selected)\n",
    "print(\"Tentative :\", boruta_tentative)"
   ]
  },
